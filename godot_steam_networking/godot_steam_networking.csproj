<Project Sdk="Godot.NET.Sdk/4.6.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EmitCompilerGeneratedFiles>false</EmitCompilerGeneratedFiles>   
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)\Generated</CompilerGeneratedFilesOutputPath>
    <!-- <DefineConstants>$(DefineConstants);THREADED_NET</DefineConstants> -->
    <!-- <DefineConstants>$(DefineConstants);BATCHING_ENABLED</DefineConstants> -->
    <DefineConstants>$(DefineConstants);TIMESTAMP_DEBUG</DefineConstants>
    <!-- <DefineConstants>$(DefineConstants);ICE_DISABLED</DefineConstants> -->
    <DefineConstants>$(DefineConstants);NET_DEBUG</DefineConstants>
    <!-- <DefineConstants>$(DefineConstants);NET_DEBUG_FULL</DefineConstants> -->
    <!-- <DefineConstants>$(DefineConstants);TIMESTAMP_DEBUG</DefineConstants> -->
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../libsteam_api.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PublishState>Included</PublishState>
    </Content>
    <ProjectReference Include="../NetworkingV2Generator/NetworkingV2Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <PackageReference Include="steamworks.net" Version="2024.8.0" />

  </ItemGroup>

</Project>